# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development
APP_NAME="Attendance & Leave Management System"
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# =============================================================================
# DATABASE — MySQL 8
# =============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=attendance_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
# Full URL (auto-constructed from above — override if needed)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/attendance_db

# =============================================================================
# JWT
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_change_in_production
ALGORITHM=HS256
# Access token: short-lived (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token: long-lived (days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# FILE STORAGE
# =============================================================================
# "local" (default, saves to disk — NOT persistent on Render/serverless hosts)
# or "cloudinary" (recommended for production — persists across deploys/restarts)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Required when STORAGE_BACKEND=cloudinary
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================================================
# NOTIFICATIONS
# =============================================================================
# FCM_SERVER_KEY=your_fcm_server_key
# Email is optional — leave SMTP_HOST unset/empty to disable sending (falls
# back to logging only). Uncomment and fill these in to enable real SMTP email.
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_USER=no-reply@yourcompany.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_USE_TLS=true
# SMTP_FROM_EMAIL=no-reply@yourcompany.com
# SMTP_FROM_NAME=AttendHR
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_FROM_NUMBER=+1234567890

# =============================================================================
# RATE LIMITING
# =============================================================================
# Requests per minute on auth endpoints
AUTH_RATE_LIMIT=10

# =============================================================================
# SEED DATA (used by scripts/seed.py)
# =============================================================================
ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=Admin@123
